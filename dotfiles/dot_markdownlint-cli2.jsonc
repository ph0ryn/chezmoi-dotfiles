{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/refs/heads/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD004": {
      "style": "dash"
    },
    "MD005": true,
    "MD007": {
      "indent": 2
    },
    "MD009": {
      "br_spaces": 2
    },
    "MD010": true,
    "MD013": false,
    "MD048": {
      "style": "backtick"
    }
  },
  "ignores": [
    "node_packages"
  ],
  "fix": true,
  "gitignore": true
}
